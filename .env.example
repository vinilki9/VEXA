
# VEXA deployment example
# Never commit the real .env file.

ENVIRONMENT=production

POSTGRES_DB=vexa
POSTGRES_USER=vexa_app
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_URL_SAFE_PASSWORD

DATABASE_URL=postgresql+psycopg://vexa_app:REPLACE_WITH_LONG_RANDOM_URL_SAFE_PASSWORD@db:5432/vexa

SECRET_KEY=REPLACE_WITH_SEPARATE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

DEFAULT_CITY_ID=obolensk
REDIS_URL=redis://redis:6379/0

API_PORT=8000
DISPATCHER_PORT=8081
