server {
    listen 80;
    server_name _;
    client_max_body_size 10m;
    location /api/ {
        proxy_pass https://109.120.184.20:20/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location /health {
        proxy_pass https://109.120.184.20:20/health;
    }
}
# Configure TLS before exposing any production service to the Internet.
