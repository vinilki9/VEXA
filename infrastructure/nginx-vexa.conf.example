# Historical Nginx example; use production Caddy gateway instead.
# > **Примечание:** рабочая конфигурация VEXA теперь рассчитана на локальный компьютер; этот документ может описывать исторический VPS. Актуальные шаги — в `README_LOCAL_SETUP.md`.


# Include these locations inside the existing HTTPS server block for
# 45.143.139.162. Keep the existing TLS certificate configuration intact.

# Dispatcher
location = /dispatch {
    return 301 /dispatch/;
}

location /dispatch/ {
    proxy_pass http://127.0.0.1:8081/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Platform Admin
location = /platform-admin {
    return 301 /platform-admin/;
}

location /platform-admin/ {
    proxy_pass http://127.0.0.1:8082/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Backend API
location /api/ {
    proxy_pass http://127.0.0.1:8000/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Health check
location = /health {
    proxy_pass http://127.0.0.1:8000/health;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# API documentation
location /docs {
    proxy_pass http://127.0.0.1:8000/docs;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Docker Compose:
# Dispatcher: 127.0.0.1:8081:80
# Platform Admin: 127.0.0.1:8082:80
# Do not expose PostgreSQL or Redis ports publicly.
