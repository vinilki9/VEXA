# Public IPv4: inbound TCP 80/443 must be reachable.
{$VEXA_DOMAIN:45.143.139.162} {
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            profile shortlived
        }
    }
    encode gzip zstd
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "DENY"
        Strict-Transport-Security "max-age=31536000"
    }
    redir /dispatch /dispatch/ 308
    redir /admin /admin/ 308
    redir /platform-admin /admin/ 308
    redir /platform-admin/* /admin/ 308
    handle_path /dispatch/* {
        reverse_proxy dispatcher:80
    }
    handle_path /admin/* {
        reverse_proxy platform_admin:80
    }
    handle_path /maps/* {
        reverse_proxy vexa_map:8090 {
            header_up X-Forwarded-Prefix /maps
        }
    }
    handle /api/* {
        reverse_proxy api:8000
    }
    handle /health {
        reverse_proxy api:8000
    }
    handle {
        redir /dispatch/ 302
    }
}
